{
  "name": "bharti-enterprise-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bharti Enterprises Production & Inventory Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w server",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w server",
    "start": "node server/dist/index.js",
    "seed:demo": "npm run seed:demo -w server",
    "dev:demo": "concurrently -n server,client -c blue,green \"npm run dev:demo -w server\" \"npm run dev -w client\"",
    "build:app": "npm run build:app -w client",
    "dev:app": "npm run dev:app -w client"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1"
  }
}
