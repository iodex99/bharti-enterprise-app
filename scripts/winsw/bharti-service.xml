<service>
  <!-- WinSW config: wraps the SUPERVISOR, not the app. The service is installed once
       and never touched by updates; the supervisor swaps app releases underneath it. -->
  <id>bharti-app</id>
  <name>Bharti Enterprises App</name>
  <description>Bharti Enterprises Production &amp; Inventory Management System (supervisor)</description>
  <!-- The Node the installer placed at ROOT\node\node.exe, not whatever is on PATH:
       the office machine is not required to have Node installed at all (ADR-044). -->
  <executable>%BASE%\..\node\node.exe</executable>
  <arguments>"%BASE%\..\supervisor\supervisor.cjs"</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <stoptimeout>20 sec</stoptimeout>
</service>
